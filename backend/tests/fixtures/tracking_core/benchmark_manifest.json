{
  "version": 1,
  "tracking_core": "apache_v1",
  "label_schema": "label_schema.json",
  "local_regression_manifest_template": "source_video_regression_manifest.example.json",
  "thresholds": {
    "pin_assisted_collar_p95_px": 10,
    "pin_assisted_collar_max_px": 18,
    "automatic_collar_p95_px": 16,
    "automatic_collar_max_px": 26,
    "minimum_active_rep_coverage": 0.9,
    "maximum_latency_ratio": 1.1,
    "hardware_identity_switches": 0
  },
  "required_clip_categories": [
    "direct_side_pinned",
    "direct_side_automatic",
    "angled_pinned",
    "angled_automatic",
    "last_rep_occlusion",
    "fast_ascent_descent"
  ],
  "promotion_requirements": {
    "minimum_independent_source_videos": 10,
    "source_video_split_only": true,
    "shadow_mode_required_before_candidate": true
  },
  "clips": []
}
