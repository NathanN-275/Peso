EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Prefer Supabase's modern public key. This value is safe to embed in clients;
# database access still depends on RLS.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Temporary one-release fallback only:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key
# Public Cloudflare Turnstile site key for the Netlify web app. Never put the
# Turnstile secret key in an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# Hosted page loaded by the native WebView. It must be this exact HTTPS path.
EXPO_PUBLIC_AUTH_CHALLENGE_URL=https://your-web-origin.example/auth/turnstile/

# Backend URL options:
# 1. Complete override. Use this when you already know the exact API URL.
# EXPO_PUBLIC_BACKEND_URL=http://10.0.0.221:8000

# 2. Platform-aware local development.
# auto | ios-simulator | android-emulator | physical-device | production
EXPO_PUBLIC_BACKEND_TARGET=auto
EXPO_PUBLIC_BACKEND_PORT=8000
EXPO_PUBLIC_MAX_VIDEO_UPLOAD_BYTES=52428800
EXPO_PUBLIC_WEB_BACKEND_HOST=localhost
EXPO_PUBLIC_DEV_MACHINE_HOST=10.0.0.221
EXPO_PUBLIC_PRODUCTION_BACKEND_URL=https://api.example.com

# Backend security controls:
# CLEANUP_JOB_TOKEN=replace-with-random-cleanup-secret
# BACKEND_ALLOW_UNAUTHENTICATED_DEV_CLEANUP=false
# BACKEND_EXPOSE_STORAGE_QUOTA_DETAILS=false
# MAX_USER_IN_PROGRESS_VIDEOS=3
# MAX_USER_UPLOADS_PER_HOUR=20
# MAX_VIDEO_DURATION_MS=300000
# SIDE_SQUAT_PREFLIGHT_SAMPLE_COUNT=12
# SIDE_SQUAT_PREFLIGHT_MAX_FRAME_DIMENSION=512
# See backend/.env.example for the versioned side-squat preflight thresholds.
# SIGNED_URL_TTL_SECONDS=300
# STORAGE_DOWNLOAD_SIGNED_URL_TTL_SECONDS=120
# FFMPEG_TIMEOUT_SECONDS=120
# MAX_GLOBAL_VIDEO_WORKERS=2
# ANALYSIS_WORKER_LEASE_SECONDS=3600
# ANALYSIS_WORKER_POLL_SECONDS=2
# ANALYSIS_WORKER_RECOVERY_SECONDS=60
# ANALYSIS_NORMAL_TIMEOUT_SECONDS=180
# ANALYSIS_MAX_TIMEOUT_SECONDS=600
# ANALYSIS_LONG_CLIP_TIMEOUT_MULTIPLIER=3
# ANALYSIS_PROFILE_MODE=legacy
# ANALYSIS_CANDIDATE_PROFILE=fast_12fps_640px
# EXPORT_COOLDOWN_SECONDS=30
# MAX_SAVED_LIFT_EXPORT_BYTES=52428800
