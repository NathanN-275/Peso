{
  "name": "peso-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/start-dev.js",
    "start:frontend": "expo start",
    "start:backend": "cd backend && .venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --env-file .env",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web:export": "expo export --platform web --output-dir dist",
    "web": "node scripts/start-dev.js --web",
    "dashboard": "node scripts/start-dashboard.js",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:typecheck": "npm --prefix dashboard run typecheck",
    "start:physical": "node scripts/start-dev.js",
    "typecheck": "tsc --noEmit",
    "test:policy": "node --test scripts/*.test.js",
    "audit:ci": "node scripts/npm-audit-ci.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.99.1",
    "expo": "^57.0.9",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-media-library": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.2",
    "expo-video-thumbnails": "~57.0.1",
    "nativewind": "^4.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-compressor": "^1.16.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.11.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~6.0.3"
  },
  "private": true,
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
