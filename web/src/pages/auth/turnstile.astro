---
const siteKey = import.meta.env.EXPO_PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; frame-src https://challenges.cloudflare.com; connect-src https://challenges.cloudflare.com; img-src data:; base-uri 'none'; form-action 'none'"
    />
    <meta name="robots" content="noindex, nofollow" />
    <title>Peso security verification</title>
    <link rel="stylesheet" href="/auth/turnstile.css" />
  </head>
  <body>
    <main
      id="peso-turnstile-root"
      data-site-key={siteKey}
      aria-label="Security verification"
    >
      <div id="peso-turnstile-widget"></div>
      <p id="peso-turnstile-status" role="status">Loading security check…</p>
    </main>
    <script is:inline src="/auth/turnstile.js"></script>
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=pesoTurnstileReady&render=explicit"
      async
      defer
    ></script>
  </body>
</html>
