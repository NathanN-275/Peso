---
import BaseLayout from '../layouts/base-layout.astro';
import SiteFooter from '../components/site-footer.astro';
import SiteHeader from '../components/site-header.astro';
---

<BaseLayout title="Beta coming soon — Peso" description="Peso’s side-view squat analysis beta is not open yet. Explore the preview while we prepare for launch.">
  <div class="page-shell legal-shell">
    <SiteHeader compact />
    <main id="main-content" class="legal-page">
      <p class="eyebrow">Side-view squat analysis</p>
      <h1>Beta coming soon</h1>
      <p>Peso’s side-view squat analysis is not open yet. This website shares information and examples of the experience we are preparing.</p>
      <p>Signup, sign-in, video uploads, and analysis are unavailable. We are not collecting email addresses or waitlist registrations.</p>
      <p>The examples are previews, and availability will be announced when the beta is ready.</p>
      <a class="button" href="/">Explore Peso</a>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
