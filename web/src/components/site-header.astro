---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<header class:list={['site-header', compact && 'site-header--compact']}>
  <a class="wordmark" href="/" aria-label="Peso home">
    <img src="/peso-logo.png" width="396" height="120" alt="Peso" />
  </a>
  <nav aria-label="Primary">
    <a class="text-link" href="/#how-it-works">How it works</a>
    <a class="text-link" href="/#coaching">Coaching</a>
    <a class="button button--small" href="/app/signup">Join beta</a>
  </nav>
</header>
